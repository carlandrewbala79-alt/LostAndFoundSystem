
@model LostAndFoundSystem.Models.RegisterViewModel

@{
    Layout = null;
    ViewData["Title"] = "Create Account";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Create Account | Campus Lost &amp; Found</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 16px;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #173b5b;
            background-image: linear-gradient(135deg, rgba(5, 91, 125, 0.55), rgba(14, 156, 204, 0.40), rgba(71, 197, 229, 0.30)), url('/images/campus-bg.png');
            background-size: cover;
            background-position: center center;
            background-attachment: fixed;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .card {
            width: 100%;
            max-width: 450px;
            background: #ffffff;
            border-radius: 24px;
            padding: 38px 36px 32px;
            box-shadow: 0 25px 60px rgba(8, 60, 85, 0.30);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 22px;
        }

        .brand-logo {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #5fd0ef;
            color: #ffffff;
        }

        .brand-logo svg {
            width: 22px;
            height: 22px;
        }

        .brand-text {
            font-size: 17px;
            font-weight: 700;
            letter-spacing: -0.4px;
            color: #174b73;
        }

        h1 {
            font-size: 28px;
            color: #183e59;
            margin-bottom: 6px;
        }

        .subtitle {
            color: #8195a2;
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 24px;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            color: #36566c;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .input-wrapper {
            position: relative;
        }

        .form-input {
            width: 100%;
            height: 46px;
            border: 1px solid #dbe6ec;
            border-radius: 11px;
            outline: none;
            padding: 0 14px;
            color: #28465a;
            font-size: 14px;
            background: #fcfeff;
            transition: 0.2s;
        }

        .form-input:focus {
            border-color: #159dcc;
            box-shadow: 0 0 0 3px rgba(21, 157, 204, 0.10);
        }

        .hint {
            color: #8a9da8;
            font-size: 11px;
            margin-top: 6px;
        }

        .password-requirements {
            margin-top: 10px;
            display: none;
            flex-direction: column;
            gap: 7px;
        }

        .password-requirements.show {
            display: flex;
        }

        .password-requirement {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #dc2626;
            font-size: 11px;
            transition: color 0.2s ease;
        }

        .requirement-icon {
            width: 16px;
            height: 16px;
            border: 1.5px solid #dc2626;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 10px;
            font-weight: 700;
            color: #dc2626;
            transition: all 0.2s ease;
        }

        .password-requirement.valid {
            color: #16a34a;
        }

        .password-requirement.valid .requirement-icon {
            background: #16a34a;
            border-color: #16a34a;
            color: #ffffff;
        }

        .field-error {
            display: block;
            color: #c14444;
            font-size: 11px;
            margin-top: 6px;
        }

        .field-error:empty {
            display: none;
        }

        .error-message {
            background: #fff1f1;
            color: #c14444;
            border: 1px solid #ffd7d7;
            padding: 10px 12px;
            border-radius: 9px;
            font-size: 12px;
            margin-bottom: 16px;
        }

        .create-btn {
            width: 100%;
            height: 48px;
            margin-top: 6px;
            border: none;
            border-radius: 11px;
            background: linear-gradient(135deg, #087ea4, #159dcc);
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 9px 20px rgba(21, 157, 204, 0.25);
            transition: 0.2s;
        }

        .create-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 25px rgba(21, 157, 204, 0.32);
        }

        .login-footer {
            text-align: center;
            color: #899ba6;
            font-size: 12px;
            margin-top: 20px;
        }

        .login-footer a {
            color: #108bc2;
            font-weight: 700;
        }

        .login-footer a:hover {
            text-decoration: underline;
        }

        @@media (max-width: 480px) {
            .card {
                padding: 30px 22px 26px;
            }

            h1 {
                font-size: 24px;
            }
        }
    </style>
</head>

<body>

    <div class="card">

        <div class="brand">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="6.5"></circle>
                    <path d="M16 16L21 21"></path>
                </svg>
            </div>

            <div class="brand-text">Campus Lost &amp; Found</div>
        </div>

        <h1>Create Account</h1>

        <p class="subtitle">
            Register with your Student ID and Gmail to report and claim items on campus.
        </p>

        @if (ViewData.ModelState.TryGetValue(string.Empty, out var generalEntry) && generalEntry.Errors.Count > 0)
        {
            <div class="error-message">@generalEntry.Errors[0].ErrorMessage</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="error-message">@TempData["Error"]</div>
        }

        <form asp-controller="Account" asp-action="Register" method="post" id="registerForm" novalidate>

            <!-- STUDENT ID -->
            <div class="form-group">
                <label for="StudentID">Student ID</label>

                <div class="input-wrapper">
                    <input asp-for="StudentID"
                           class="form-input"
                           type="text"
                           autocomplete="off" />
                </div>

                <span asp-validation-for="StudentID" class="field-error"></span>
            </div>

            <!-- E-MAIL ADDRESS -->
            <div class="form-group">
                <label for="Email">E-mail Address</label>

                <div class="input-wrapper">
                    <input asp-for="Email"
                           class="form-input"
                           type="email"
                           autocomplete="email" />
                </div>

                <div class="hint">
                    We will send a 6-digit verification code to this E-mail Address.
                </div>

                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <!-- PASSWORD -->
            <div class="form-group">
                <label for="Password">Enter Password</label>

                <div class="input-wrapper">
                    <input asp-for="Password"
                           class="form-input"
                           type="password"
                           autocomplete="new-password"
                           aria-describedby="passwordRequirements" />
                </div>

                <div class="password-requirements" id="passwordRequirements">
                    <div class="password-requirement" id="reqLength">
                        <span class="requirement-icon">!</span>
                        <span>At least 8 characters</span>
                    </div>

                    <div class="password-requirement" id="reqLetter">
                        <span class="requirement-icon">!</span>
                        <span>Contains a letter (A–Z)</span>
                    </div>

                    <div class="password-requirement" id="reqNumber">
                        <span class="requirement-icon">!</span>
                        <span>Contains a number (0–9)</span>
                    </div>
                </div>

                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <!-- CONFIRM PASSWORD -->
            <div class="form-group">
                <label for="ConfirmPassword">Confirm Password</label>

                <div class="input-wrapper">
                    <input asp-for="ConfirmPassword"
                           class="form-input"
                           type="password"
                           autocomplete="new-password" />
                </div>

                <span asp-validation-for="ConfirmPassword"
                      class="field-error"
                      id="confirmError"></span>
            </div>

            <button type="submit" class="create-btn">Create Account</button>

        </form>

        <div class="login-footer">
            Already have an account?
            <a asp-controller="Account" asp-action="Login">Login</a>
        </div>

    </div>

    <script>
        const passwordInput = document.getElementById("Password");
        const confirmInput = document.getElementById("ConfirmPassword");
        const confirmError = document.getElementById("confirmError");
        const requirementsContainer = document.getElementById("passwordRequirements");

        const requirementElements = {
            length: document.getElementById("reqLength"),
            letter: document.getElementById("reqLetter"),
            number: document.getElementById("reqNumber")
        };

        function updatePasswordRequirements() {
            const password = passwordInput.value;

            // Hide all requirements when the password field is empty.
            if (password.length === 0) {
                requirementsContainer.classList.remove("show");
                return;
            }

            // Show the requirements once the user starts typing.
            requirementsContainer.classList.add("show");

            // Determine which requirement should appear first based on
            // the first character typed.
            let firstRequirement;

            if (/[0-9]/.test(password.charAt(0))) {
                firstRequirement = "number";
            } else if (/[a-zA-Z]/.test(password.charAt(0))) {
                firstRequirement = "letter";
            } else {
                firstRequirement = "length";
            }

            // On the first character, show only its matching requirement.
            // When the user types more characters, show all requirements.
            const orderedRequirements = [
                firstRequirement,
                ...["length", "letter", "number"].filter(
                    requirement => requirement !== firstRequirement
                )
            ];

            Object.values(requirementElements).forEach(function (element) {
                element.style.display = password.length === 1 ? "none" : "flex";
            });

            // Keep the first-character requirement at the top.
            orderedRequirements.forEach(function (requirement) {
                requirementsContainer.appendChild(requirementElements[requirement]);
            });

            // Always show the first matching requirement for the first character.
            requirementElements[firstRequirement].style.display = "flex";

            const checks = {
                length: password.length >= 8,
                letter: /[a-zA-Z]/.test(password),
                number: /[0-9]/.test(password)
            };

            Object.keys(requirementElements).forEach(function (requirement) {
                const element = requirementElements[requirement];
                const icon = element.querySelector(".requirement-icon");

                element.classList.toggle("valid", checks[requirement]);
                icon.textContent = checks[requirement] ? "✓" : "!";
            });
        }

        function validatePasswordConfirmation() {
            if (confirmInput.value.length === 0) {
                confirmError.textContent = "";
                return true;
            }

            if (passwordInput.value !== confirmInput.value) {
                confirmError.textContent = "Passwords do not match.";
                return false;
            }

            confirmError.textContent = "";
            return true;
        }

        passwordInput.addEventListener("input", function () {
            updatePasswordRequirements();

            if (confirmInput.value.length > 0) {
                validatePasswordConfirmation();
            }
        });

        confirmInput.addEventListener("input", validatePasswordConfirmation);

        updatePasswordRequirements();

        document.getElementById("registerForm").addEventListener("submit", function (e) {
            const password = passwordInput.value;
            const confirm = confirmInput.value;

            const hasMinimumLength = password.length >= 8;
            const hasLetter = /[a-zA-Z]/.test(password);
            const hasNumber = /[0-9]/.test(password);

            if (!hasMinimumLength || !hasLetter || !hasNumber) {
                e.preventDefault();

                updatePasswordRequirements();

                passwordInput.focus();
                return;
            }

            if (password !== confirm) {
                e.preventDefault();

                confirmError.textContent = "Passwords do not match.";
                confirmError.style.display = "block";

                confirmInput.focus();
            }
        });
    </script>

</body>
</html>
